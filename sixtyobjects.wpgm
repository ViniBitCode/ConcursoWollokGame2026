import wollok.game.*
import source.personajes.jugador.*
import source.fases.Fase1.reloj.*
import source.fases.Fase1.fondoDeNivel.*
import source.fases.Fase0.menuPrincipal.*
import source.sonidoManager.sonidoManager.*

object configuracion {
  method configureGeneralSettings() {
    game.width(30)
    game.height(16)
    game.cellSize(50)

    game.title("60 Objects!")
    sonidoManager.cambiarSonidoBackground("fondos/Fase0/sonidoMenu.wav")
  }
}

program sixtyobjects {
  configuracion.configureGeneralSettings()
  menuPrincipal.mostrar()
  game.start()
}